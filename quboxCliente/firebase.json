{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/**",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" },
          { "key": "X-API-WS-DOMAIN", "value": "https://qbox-api.onrender.com" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "destination": "http://localhost:8080"
      }
    ]
  }
}
